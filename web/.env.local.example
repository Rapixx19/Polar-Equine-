# slice 1 — bearer round-trip with algo
ALGO_BASE_URL=http://localhost:8787
ALGO_BEARER_TOKEN=

# slice 3 / 12 — Supabase email + password auth (magic-link removed in slice 12)
# IMPORTANT: in the Supabase dashboard, Auth → Providers → Email,
# turn OFF "Confirm email" so signups return a session immediately.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# comma-separated admin emails; first sign-in matching this list becomes admin
ADMIN_EMAILS=ferdinand.straehuber@gmail.com

# slice 16.A — per-session Claude narrative on /admin/sessions/[id]
# server-side only (never reaches the browser); optional locally — only
# needed to test the "Generate insight" button. Required in Vercel
# prod + preview for the deployed admin page to work.
ANTHROPIC_API_KEY=
